[flake8]
max-line-length = 79
extend-ignore = 
    E203,  # whitespace before ':'
    W503,  # line break before binary operator
    E501,  # line too long (handled by black)
    F401,  # imported but unused (for __init__.py)
    B008,  # do not perform function calls in argument defaults
    C901,  # too complex
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .mypy_cache,
    build,
    dist,
    *.egg-info
per-file-ignores =
    __init__.py:F401
    tests/*:E501,B011